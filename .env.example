# Drust backend (https://tool.tzuchi-org.tw)
DRUST_BASE_URL=https://tool.tzuchi-org.tw
DRUST_TENANT_ID=1e195719-6106-4644-85d1-0eee7d135026
# Anon token — server proxies CRUD on docs/playlists/files with it. Drust
# enforces what anon can do per-collection via anon_caps (must include
# select,insert,update,delete on docs + playlists). Also embedded in
# /api/config so the browser can subscribe directly to broadcast WS.
DRUST_ANON_TOKEN=drust_REPLACE_ME
# Service token — held server-side ONLY for broadcast publish via
# routes/publish.ts. Never reaches the browser.
DRUST_SERVICE_TOKEN=drust_REPLACE_ME

# Optional: server port (defaults to 3000)
# PORT=3000
